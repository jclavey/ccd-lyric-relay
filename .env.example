# Token ccd-propresenter-bridge must send (its LYRICS_RELAY_TOKEN) — required
INBOUND_API_TOKEN=change-me

# Ports for the bridge WebSocket and the display page
EVENT_SOURCE_PORT=3000
DISPLAY_SERVER_PORT=8080

# Keep showing the last slide this long after the bridge drops unexpectedly
# STATE_GRACE_MS=60000

# Report the number of viewers to the ccd-bridge-status dashboard. Off unless
# STATUS_URL is set. STATUS_TOKEN is the dashboard's INBOUND_API_TOKEN.
# STATUS_URL=https://ccd-bridge-status.up.railway.app
# STATUS_TOKEN=
# How often the count is checked, and how often an unchanged non-zero count is
# re-sent. Keep the dashboard's USER_COUNT_STALE_SECONDS at twice the keepalive.
# USER_COUNT_INTERVAL_MS=60000
# USER_COUNT_KEEPALIVE_MS=600000
